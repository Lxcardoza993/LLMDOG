# llmdog 配置示例 —— 复制为 config.env 填实际值,然后 chmod 600 config.env
# 改完无需 daemon-reload(systemd EnvironmentFile 每次跑读);改 DRY_RUN 后下轮 timer 自动生效

# DRY_RUN=1: 只探活+分析+假执行(不动真格,记日志);跑稳改 0 开真修复
LLMDOG_DRY_RUN=1

# LLM 端点(直连你的 LLM 代理/中转站,不走 clash 出口——防 clash 挂时看门狗也调不通 LLM)
LLMDOG_LLM_URL=http://127.0.0.1:8317/v1/messages
LLMDOG_LLM_KEY=YOUR_CPA_KEY_HERE
LLMDOG_LLM_MODEL=deepseek-v4-pro

# TG 通知(留空则只写日志不发 TG;telegram 大陆需代理)
LLMDOG_TG_BOT_TOKEN=YOUR_TG_BOT_TOKEN
LLMDOG_TG_CHAT_ID=YOUR_TG_CHAT_ID
LLMDOG_TG_PROXY=http://127.0.0.1:8899
